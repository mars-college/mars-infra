#!/usr/bin/env python3
"""Read local status and private-path metadata only; never deploy."""
import argparse
import os
import pathlib
import pwd
import stat
import subprocess
import sys

TIMEOUT = 5


def command(args, environment):
    try:
        result = subprocess.run(args, env=environment, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                text=True, timeout=TIMEOUT, check=False)
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired, UnicodeError):
        return None, ""


def private_path(path, account, directory):
    try:
        info = path.lstat()
    except (OSError, ValueError):
        return False
    kind = stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode)
    return (kind and info.st_uid == account.pw_uid and info.st_gid == account.pw_gid
            and stat.S_IMODE(info.st_mode) == (0o700 if directory else 0o600))


def run(expected_user, env_file=None, state_dir=None):
    real_uid, effective_uid = os.getuid(), os.geteuid()
    if not expected_user or real_uid == 0 or effective_uid == 0 or real_uid != effective_uid:
        print("FAIL identity: matching non-root local account required")
        return 1
    try:
        account = pwd.getpwuid(effective_uid)
    except (KeyError, OSError):
        print("FAIL identity: local account lookup failed")
        return 1
    if account.pw_name != expected_user or account.pw_uid != effective_uid:
        print("FAIL identity: expected local account required")
        return 1
    # Do not forward arbitrary caller configuration or credentials to status tools.
    environment = {"PATH": "/usr/bin:/bin", "HOME": account.pw_dir,
                   "USER": account.pw_name, "LOGNAME": account.pw_name,
                   "XDG_RUNTIME_DIR": f"/run/user/{account.pw_uid}", "LC_ALL": "C"}
    failed = False

    def report(label, ok):
        nonlocal failed
        print(("PASS " if ok else "FAIL ") + label)
        failed = failed or not ok

    code, text = command(["/usr/bin/systemctl", "--user", "show", "mars-mcp.service", "--no-pager",
                          "--property=LoadState", "--property=ActiveState", "--property=SubState",
                          "--property=UnitFileState"], environment)
    properties = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    report("user unit loaded/active/running/enabled", code == 0 and properties == {
        "LoadState": "loaded", "ActiveState": "active", "SubState": "running", "UnitFileState": "enabled"})
    code, text = command(["/usr/bin/podman", "container", "inspect", "--format", "{{.State.Status}}", "mars-mcp"], environment)
    report("rootless mars-mcp container running", code == 0 and text == "running")
    code, text = command(["/usr/bin/podman", "port", "mars-mcp", "4400/tcp"], environment)
    report("container publishes only 127.0.0.1:4400", code == 0 and text == "127.0.0.1:4400")
    # lstat only: do not read contents, enumerate storage, or print private paths.
    home = pathlib.Path(account.pw_dir)
    env_path = pathlib.Path(env_file) if env_file is not None else home / ".config/mars-mcp/runtime.env"
    state_path = pathlib.Path(state_dir) if state_dir is not None else home / ".local/state/mars-mcp"
    report("private env file ownership/mode", private_path(env_path, account, False))
    report("private auth-state directory ownership/mode", private_path(state_path, account, True))
    print("HOST CHECK FAILED: inspect privately with an authorized operator" if failed else
          "HOST STATUS OK: deployment identity, credentials and login remain unverified")
    return 1 if failed else 0


class PrivateArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(2, "check-host: invalid arguments\n")


def main(argv=None):
    parser = PrivateArgumentParser(description=__doc__)
    parser.add_argument("--user", required=True, metavar="EXPECTED_ACCOUNT")
    parser.add_argument("--env-file", metavar="PATH", help="env file metadata to check")
    parser.add_argument("--state-dir", metavar="PATH", help="auth-state directory metadata to check")
    args = parser.parse_args(argv)
    return run(args.user, args.env_file, args.state_dir)


if __name__ == "__main__":
    sys.exit(main())
